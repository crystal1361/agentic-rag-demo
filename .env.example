# Pick one or both. LLM_PROVIDER selects which one the agent uses at runtime.
LLM_PROVIDER=anthropic          # "anthropic" or "openai"

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Cheaper option for repeated eval runs: ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Embeddings run locally (sentence-transformers), no API key needed.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval / agent tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SIMILARITY_THRESHOLD=0.35
MAX_HOPS=3          # v1 loop: retrieval hops per sub-question
MAX_STEPS=8         # tool agent: max model turns per question
SQL_ROW_LIMIT=50    # tool agent: max rows one SQL call returns

# Per-question JSONL traces ("" to disable)
TRACE_DIR=traces

# Optional: current list prices (USD per million tokens) for the model you run,
# used only to add a cost-per-question column to eval reports.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
